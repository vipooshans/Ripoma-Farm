# Backend API Base URL for hosted deployments
# Leave empty for local development (defaults to local Vite proxy)
VITE_API_URL=https://ripoma-farm.onrender.com

# Google Identity Services (storefront Sign in with Google)
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins should include https://farm.ripomaglobal.org and http://localhost:3000
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

