# ==============================================================================
# RIPOMA FARM & FOODS — SECURE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to 'backend/.env' (DO NOT commit '.env' to version control):
#    cp .env.example backend/.env
# 2. Generate strong, cryptographically secure secrets for each *_SECRET variable:
#    node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# 3. Rotate ADMIN secrets every 90 days or immediately if a leak is suspected.
# 4. Remove SEED_SUPER_ADMIN_* variables from .env after initial bootstrap login.
# ==============================================================================

# Server Runtime Settings
PORT=5050
# 127.0.0.1 = this machine only; 0.0.0.0 = reachable from other devices on the LAN
HOST=127.0.0.1
NODE_ENV=development

# Database Connection (MongoDB URI, or leave empty for JSON filesystem mode)
# Atlas: mongodb+srv://<user>:<url-encoded-password>@<cluster>.mongodb.net/ripoma_farm?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/ripoma_farm
# true = exit if MongoDB is unreachable instead of falling back to local JSON files
REQUIRE_MONGODB=false

# ------------------------------------------------------------------------------
# SEPARATE JWT SIGNING SECRETS (Role Isolation)
# ------------------------------------------------------------------------------
# Customer JWT Secrets (15m access expiry / 7d refresh expiry)
CUSTOMER_JWT_ACCESS_SECRET=your_customer_jwt_access_secret_64_char_hex_here
CUSTOMER_JWT_REFRESH_SECRET=your_customer_jwt_refresh_secret_64_char_hex_here

# Admin & Worker JWT Secrets (15m access expiry / 1d refresh expiry)
ADMIN_JWT_ACCESS_SECRET=your_admin_jwt_access_secret_64_char_hex_here
ADMIN_JWT_REFRESH_SECRET=your_admin_jwt_refresh_secret_64_char_hex_here

# Admin 2FA Temporary Challenge Secret (5m expiry for 2FA validation step)
ADMIN_2FA_TEMP_SECRET=your_admin_2fa_temp_secret_64_char_hex_here

# Legacy compatibility fallback secret (Optional)
JWT_SECRET=your_legacy_jwt_fallback_secret_here

# ------------------------------------------------------------------------------
# BOOTSTRAP SEED SUPER ADMIN CREDENTIALS
# (Used only once to create the initial admin account if the database is empty.
#  Change password after first login and remove these lines from production .env)
# ------------------------------------------------------------------------------
SEED_SUPER_ADMIN_NAME=Super Administrator
SEED_SUPER_ADMIN_EMAIL=admin@ripomafarm.com
SEED_SUPER_ADMIN_PASSWORD=ChangeMeImmediately@2026!

# ------------------------------------------------------------------------------
# THIRD-PARTY INTEGRATIONS & OAUTH
# ------------------------------------------------------------------------------
# Google OAuth Client ID (Storefront Customer Sign-in)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
